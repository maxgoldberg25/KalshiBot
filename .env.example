# ───────────────────────────────────────────────────────────
# Kalshi vs Sportsbook Odds Scanner – Environment Configuration
# Copy to .env and fill in your credentials.
# ───────────────────────────────────────────────────────────

# ── Kalshi ──────────────────────────────────────────────────
KALSHI_ODDS_KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_ODDS_KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private_key.pem

# ── The Odds API ────────────────────────────────────────────
# Get free API key: https://the-odds-api.com/
# Free tier: 500 requests/month
KALSHI_ODDS_ODDS_API_KEY=your-odds-api-key

# ── OddsPapi (fallback provider) ──────────────────────────
# Get free API key: https://oddspapi.io/en/account
# Free tier: 250 requests/month, 350+ bookmakers
# Auto-switches when Odds API quota runs out
KALSHI_ODDS_ODDSPAPI_API_KEY=

# ── Scanner settings ────────────────────────────────────────
# Periodic sportsbook arb scan (Odds API every poll). Default false: Insider Watch only.
# KALSHI_ODDS_BACKGROUND_SCAN_ENABLED=true
KALSHI_ODDS_KALSHI_SLIPPAGE_BUFFER=0.005  # 0.5% slippage buffer for Kalshi
KALSHI_ODDS_SPORTSBOOK_EXECUTION_FRICTION=0.01  # 1% friction for sportsbook
KALSHI_ODDS_MIN_EDGE_BPS=50.0  # Min 50 basis points (0.5%) edge to alert
KALSHI_ODDS_MIN_LIQUIDITY=10  # Min 10 shares liquidity
KALSHI_ODDS_MAX_STALENESS_SECONDS=60.0  # Max 60s data age
KALSHI_ODDS_POLY_ENABLED=true
KALSHI_ODDS_POLY_MIN_EDGE_BPS=20.0
KALSHI_ODDS_POLY_MIN_LIQUIDITY_USD=100.0
KALSHI_ODDS_POLY_MATCH_THRESHOLD=82.0

# ── Matching ────────────────────────────────────────────────
KALSHI_ODDS_MAPPING_FILE=mappings.yaml
KALSHI_ODDS_FUZZY_MATCH_ENABLED=false
KALSHI_ODDS_FUZZY_MATCH_THRESHOLD=0.75

# ── Output ──────────────────────────────────────────────────
KALSHI_ODDS_OUTPUT_JSONL=alerts.jsonl

# ── Execution & dashboard ─────────────────────────────────
# KALSHI_ODDS_EXECUTION_ENABLED=false
# KALSHI_ODDS_MAX_NOTIONAL_PER_TRADE=100.0
# KALSHI_ODDS_BANKROLL_DOLLARS=500.0
# KALSHI_ODDS_KELLY_FRACTION=0.25
# KALSHI_ODDS_DASHBOARD_PORT=8080
# KALSHI_ODDS_AUTO_EXECUTE_MIN_CONFIDENCE=high

# ── Accounts (first admin bootstrap) ────────────────────────
# Default: invite-only. For the first account only, uncomment:
# KALSHI_ODDS_PUBLIC_REGISTRATION_ENABLED=true
# KALSHI_ODDS_ADMIN_BOOTSTRAP_USERNAMES=your_username_here
# Register via SPA or scripts/bootstrap-register.sh, then set PUBLIC back to false.
