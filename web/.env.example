# Base URL of the FastAPI backend. Leave empty to use the same origin
# (useful for local dev when vite's proxy forwards /api to 127.0.0.1:8080,
#  or when the Python server is serving the built SPA from web/dist).
#
# In production on Vercel, set this to your backend origin, e.g.:
#   VITE_API_BASE_URL=https://api.kalshibot.example.com
#
# No trailing slash.
VITE_API_BASE_URL=
